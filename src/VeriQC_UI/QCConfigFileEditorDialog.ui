       </item>
       <item>
        <widget class="QWidget" name="baselineWidget">
         <layout class="QGridLayout" name="baselineLayout">
          <item row="0" column="0" colspan="2">
           <widget class="QCheckBox" name="inputTrueXYZChk">
            <property name="text">
             <string>Input true base/rover XYZ (zero/short baseline QC)</string>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="baseTrueXYZLabel">
            <property name="text">
             <string>Base True XYZ [m]:</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QLineEdit" name="baseTrueXYZEdit">
            <property name="placeholderText">
             <string>x,y,z  e.g. -2828180.26,4673771.36,3281109.05</string>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="roverTrueXYZLabel">
            <property name="text">
             <string>Rover True XYZ [m]:</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QLineEdit" name="roverTrueXYZEdit">
            <property name="placeholderText">
             <string>x,y,z</string>
            </property>
           </widget>
